VertexLitGeneric
{
	$basetexture			"models\unitvehiclescars\shared\underside.vtf"

	$blendtintbybasealpha	1

	$rimlight 1
	$rimlightboost 0.5
	$envmap					env_cubemap
	$envmapsaturation		0.5
	$envmaptint 			"[.1 .1 .1]"
	$normalmapalphaenvmapmask 1
	$phongfix "{1 1 1}"

	Proxies
	{
		Equals
		{
			srcVar1		$color2
			resultVar	$color
		}
	}
}