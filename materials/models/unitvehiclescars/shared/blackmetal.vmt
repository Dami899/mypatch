VertexLitGeneric
{
	$basetexture			"models\unitvehiclescars\shared\aluminium.vtf"

	$nocull 1

	$blendtintbybasealpha	1

	$envmap					env_cubemap
	$envmapsaturation		0.5
	$envmaptint 			"[.25 .25 .25]"

	$color2				"[.1 .1 .1]"

	Proxies
	{
		Equals
		{
			srcVar1		$color2
			resultVar	$color
		}
	}
}
