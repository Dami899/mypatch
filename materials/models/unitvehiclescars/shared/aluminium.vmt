VertexLitGeneric
{
	$basetexture			"models\unitvehiclescars\shared\aluminium.vtf"

	$nocull 1

	$blendtintbybasealpha	1

	$envmap					env_cubemap
	$envmapsaturation		0.5
	$envmaptint 			"[0.7 0.7 0.7]"

	$color2				"[1 1 1]"

	Proxies
	{
		Equals
		{
			srcVar1		$color2
			resultVar	$color
		}
	}
}
